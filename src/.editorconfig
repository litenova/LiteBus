root = false

[*.cs]
# StyleCop: enforce XML documentation rules only (see AGENTS.md).
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = warning
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none

# Documentation category includes file-header rules LiteBus does not use.
dotnet_diagnostic.SA1633.severity = none
dotnet_diagnostic.SA1634.severity = none
dotnet_diagnostic.SA1635.severity = none
dotnet_diagnostic.SA1636.severity = none
dotnet_diagnostic.SA1637.severity = none
dotnet_diagnostic.SA1638.severity = none

# Code style analyzers (see AGENTS.md "Code style and analyzers").
dotnet_diagnostic.CA1510.severity = warning
dotnet_diagnostic.CA1511.severity = warning
dotnet_diagnostic.CA2007.severity = warning
dotnet_diagnostic.CA1069.severity = warning
dotnet_diagnostic.CA1031.severity = warning
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.SA1402.severity = warning
dotnet_diagnostic.SA1649.severity = warning

# Bracket generic filenames (for example LazyHandler[THandler, TDescriptor].cs) are intentional; StyleCop cannot match them.
[**/*\[*\]*.cs]
dotnet_diagnostic.SA1649.severity = none

dotnet_diagnostic.IDE0161.severity = error
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.IDE0007.severity = none

# LiteBus public terminology intentionally uses registry, event-handler, queue-target, and concise context access names.
[LiteBus.Runtime.Abstractions/Dependencies/IDependencyRegistry.cs]
dotnet_diagnostic.CA1710.severity = none

[LiteBus.Runtime.Abstractions/Modules/IModuleRegistry.cs]
dotnet_diagnostic.CA1716.severity = none

[LiteBus.Messaging.Abstractions/IHandleContextData.cs]
dotnet_diagnostic.CA1716.severity = none

# Declare is the verb the whole declaration model is named after, and this collector is supplied by the framework and
# never implemented by a consumer, so the cross-language override concern the rule exists for does not arise.
[LiteBus.Messaging.Abstractions/Definitions/IMessageDeclarations.cs]
dotnet_diagnostic.CA1716.severity = none

[LiteBus.Events.Abstractions/IEventHandler*.cs]
dotnet_diagnostic.CA1711.severity = none

[LiteBus.Events.Abstractions/IEventMediator.cs]
dotnet_diagnostic.CA1716.severity = none

[LiteBus.Outbox.Abstractions/PublicationTarget.cs]
dotnet_diagnostic.CA1711.severity = none

# Static factories live on the immutable record passed to writer APIs by design.
[LiteBus.Outbox.Abstractions/OutboxEnqueueItem*.cs]
dotnet_diagnostic.CA1000.severity = none

[LiteBus.Saga.Abstractions/SagaSaveItem*.cs]
dotnet_diagnostic.CA1000.severity = none

# Static factories live on the verdict and shortcut structs a guard or shortcut returns by design.
[LiteBus.Messaging.Abstractions/Handler/Pre/{Verdict,Shortcut}*.cs]
dotnet_diagnostic.CA1000.severity = none

# Same shape on the result a Try mediator method returns, so the outcome is named at the construction site.
[LiteBus.Messaging.Abstractions/Pipeline/MediationResult*.cs]
dotnet_diagnostic.CA1000.severity = none
