<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <IsTestProject>false</IsTestProject>
        <Description>Cross-provider inbox and outbox store conformance test bases for LiteBus storage adapters.</Description>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>LiteBus.Storage.Testing</PackageId>
        <VersionPrefix>7.0.0</VersionPrefix>
        <PackageTags>litebus;testing;storage;conformance</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageProjectUrl>https://litebus.io/</PackageProjectUrl>
        <!-- Matches src/Directory.Build.props: link to the release for the version being packed, not to a fixed one. -->
        <PackageReleaseNotes Condition="'$(Version)' != ''">https://github.com/litenova/LiteBus/releases/tag/v$(Version)</PackageReleaseNotes>
        <PackageReleaseNotes Condition="'$(Version)' == ''">https://github.com/litenova/LiteBus/blob/main/Changelog.md</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/litenova/LiteBus</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>A. Shafie</Authors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
        <None Include="..\..\assets\logo\icon.png" Pack="true" PackagePath="icon.png" />
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="xunit" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\LiteBus.Inbox.Abstractions\LiteBus.Inbox.Abstractions.csproj" />
        <ProjectReference Include="..\..\src\LiteBus.Outbox.Abstractions\LiteBus.Outbox.Abstractions.csproj" />
    </ItemGroup>
</Project>
