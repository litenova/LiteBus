<Project>
    <PropertyGroup>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <AnalysisMode>Recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <VersionPrefix>7.0.0</VersionPrefix>
        <LangVersion>latest</LangVersion>
        <Authors>A. Shafie</Authors>
        <PackageTags>litebus;mediator;messaging;cqrs</PackageTags>
        <PackageIcon>icon.png</PackageIcon>
        <Description>Mediator and durable messaging contracts for explicit command, query, event, inbox, and outbox composition in .NET applications.</Description>
        <PackageProjectUrl>https://litebus.io/</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/litenova/LiteBus/blob/main/Changelog.md#v602</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/litenova/LiteBus</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <!-- For Signing -->
        <SignAssembly Condition="Exists('$(MSBuildThisFileDirectory)..\LiteBus.snk')">true</SignAssembly>
        <AssemblyOriginatorKeyFile Condition="Exists('$(MSBuildThisFileDirectory)..\LiteBus.snk')">$(MSBuildThisFileDirectory)..\LiteBus.snk</AssemblyOriginatorKeyFile>
        <!--
            The public key every LiteBus assembly is signed with. InternalsVisibleTo across signed assemblies has to
            name it, so it lives here rather than being repeated at every grant.
        -->
        <LiteBusPublicKey></LiteBusPublicKey>
        <!-- Source Link -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Abstractions'))">
        <Description>Contracts and value objects for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);abstractions;contracts</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Storage.'))">
        <Description>Storage adapter and registration APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);storage;durable-messaging</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Dispatch'))">
        <Description>Outbound dispatch adapter and registration APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);dispatch;durable-messaging</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Ingress'))">
        <Description>Inbox ingress adapter and registration APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);ingress;durable-messaging</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Transport'))">
        <Description>Transport contracts, runtime behavior, or adapter integration for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);transport;broker</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Extensions.'))">
        <Description>Host-framework composition APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);extensions;composition</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\assets\logo\icon.png" Pack="true" PackagePath=""/>
        <None Include="..\..\README.md" Pack="true" PackagePath=""/>
        <InternalsVisibleTo Include="LiteBus.MessageModule.UnitTests, PublicKey=$(LiteBusPublicKey)"/>
        <InternalsVisibleTo Include="LiteBus.Mediator.UnitTests, PublicKey=$(LiteBusPublicKey)"/>
        <InternalsVisibleTo Include="LiteBus.Transport.UnitTests, PublicKey=$(LiteBusPublicKey)"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\stylecop.json" Link="stylecop.json"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"/>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
