<Project>
    <ItemGroup>
        <PackageVersion Include="Autofac" Version="9.3.2"/>
        <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2"/>
        <!-- Held on EF Core 9.x: Pomelo.EntityFrameworkCore.MySql, used by the MySQL storage tests, has no EF Core 10 provider. -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.19"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.19"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11"/>
        <PackageVersion Include="OpenTelemetry" Version="1.18.0"/>
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All"/>
        <!-- Held on Npgsql 9.x to match the EF Core 9 PostgreSQL provider used by the storage tests. -->
        <PackageVersion Include="Npgsql" Version="9.0.5"/>
        <PackageVersion Include="Marten" Version="9.50.1"/>
        <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.11"/>
        <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.2"/>
        <PackageVersion Include="Confluent.Kafka" Version="2.15.0"/>
        <PackageVersion Include="RabbitMQ.Client" Version="7.2.2"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
    </ItemGroup>
</Project>
