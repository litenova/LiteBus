{
  "name": "litebus-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "local-md dev -- node node_modules/next/dist/bin/next dev --port 3100",
    "build": "next build && npm run check:links && npm run check:llms && npm run check:search-trace",
    "check:links": "node scripts/check-rendered-links.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "check:search-trace": "node scripts/check-search-trace.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/local-md": "^0.3.0",
    "fumadocs-core": "^16.11.5",
    "next": "^16.2.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "typescript": "^5.9.3"
  }
}
