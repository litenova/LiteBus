{
  "name": "litebus-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "predev": "npm run sync:changelog",
    "prebuild": "npm run sync:changelog",
    "dev": "local-md dev -- node node_modules/next/dist/bin/next dev --port 3100",
    "build": "next build && npm run check:links && npm run check:llms && npm run check:search-trace && npm run check:titles",
    "check:links": "node scripts/check-rendered-links.mjs",
    "check:llms": "node scripts/check-llms.mjs",
    "check:search-trace": "node scripts/check-search-trace.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fumadocs/local-md": "^0.3.5",
    "fumadocs-core": "^16.17.7",
    "next": "^16.4.2",
    "ondine": "^0.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "typescript": "~6.0.3"
  }
}
