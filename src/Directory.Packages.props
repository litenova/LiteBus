<Project>
    <ItemGroup>
        <PackageVersion Include="Autofac" Version="9.3.4"/>
        <PackageVersion Include="Autofac.Extensions.DependencyInjection" Version="11.0.2"/>
        <!-- EF Core 10 removed SetPropertyCalls<T>, so assemblies built against EF Core 9 fail at runtime on EF Core 10 (#167). -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.14"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14"/>
        <PackageVersion Include="OpenTelemetry" Version="1.20.1"/>
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="All"/>
        <PackageVersion Include="Npgsql" Version="10.0.3"/>
        <PackageVersion Include="Marten" Version="9.57.0"/>
        <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.23"/>
        <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0"/>
        <PackageVersion Include="Confluent.Kafka" Version="2.16.0"/>
        <PackageVersion Include="RabbitMQ.Client" Version="7.2.2"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
    </ItemGroup>
</Project>
