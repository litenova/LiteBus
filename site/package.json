{
  "name": "litebus-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "predev": "pnpm run sync:changelog",
    "prebuild": "pnpm run sync:changelog",
    "dev": "astro dev --port 3100",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview --port 3100",
    "typecheck": "astro check",
    "test": "node --test \"src/**/*.test.ts\"",
    "check": "node scripts/check-site.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "astro": "7.3.5",
    "ondine": "^0.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "pagefind": "1.5.2",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  }
}
