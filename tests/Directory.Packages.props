<Project>
    <ItemGroup>
        <PackageVersion Include="Autofac" Version="9.3.4"/>
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing.XUnit" Version="1.1.2"/>
        <!-- The analyzer tests compile against Roslyn 4.8.0, the compiler the shipped analyzer is built against. -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.8.0"/>
        <PackageVersion Include="NuGet.Versioning" Version="7.9.0"/>
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556"/>
        <!-- Held on EF Core 9.x: Pomelo.EntityFrameworkCore.MySql has no EF Core 10 provider. -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="9.0.21"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.21"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.21"/>
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13"/>
        <PackageVersion Include="Marten" Version="9.51.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13"/>
        <PackageVersion Include="OpenTelemetry" Version="1.20.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13"/>
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0"/>
        <PackageVersion Include="Npgsql" Version="9.0.5"/>
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4"/>
        <PackageVersion Include="Testcontainers" Version="4.16.0"/>
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.21"/>
        <PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0"/>
        <!-- Held on 2.1.x to match the SQLitePCLRaw major that the EF Core 9 SQLite provider was built against. -->
        <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14"/>
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.MySql" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.Kafka" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.Redpanda" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.LocalStack" Version="4.16.0"/>
        <PackageVersion Include="Testcontainers.ServiceBus" Version="4.16.0"/>
        <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.21.0"/>
        <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.19"/>
        <PackageVersion Include="Confluent.Kafka" Version="2.16.0"/>
        <PackageVersion Include="RabbitMQ.Client" Version="7.2.2"/>
        <PackageVersion Include="xunit" Version="2.9.3"/>
        <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85"/>
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageVersion>
        <PackageVersion Include="coverlet.collector" Version="10.1.0">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageVersion>
    </ItemGroup>
</Project>
