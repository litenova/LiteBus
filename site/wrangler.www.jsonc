// www.litebus.io: a one-file Worker that redirects to litebus.io.
// Deploy with: wrangler deploy --config wrangler.www.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "litebus-www",
  "main": "./workers/www-redirect.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "www.litebus.io", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
