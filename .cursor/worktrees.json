{
  "setup-worktree-windows": [
    "if exist \"%ROOT_WORKTREE_PATH%\\.env\" copy \"%ROOT_WORKTREE_PATH%\\.env\" .env",
    "if exist \"%ROOT_WORKTREE_PATH%\\.env.local\" copy \"%ROOT_WORKTREE_PATH%\\.env.local\" .env.local",
    "dotnet restore LiteBus.slnx",
    "dotnet build LiteBus.slnx --no-restore -v quiet"
  ],
  "setup-worktree-unix": [
    "[ -f \"$ROOT_WORKTREE_PATH/.env\" ] && cp \"$ROOT_WORKTREE_PATH/.env\" .env || true",
    "[ -f \"$ROOT_WORKTREE_PATH/.env.local\" ] && cp \"$ROOT_WORKTREE_PATH/.env.local\" .env.local || true",
    "dotnet restore LiteBus.slnx",
    "dotnet build LiteBus.slnx --no-restore -v quiet"
  ]
}
