<Project>
    <PropertyGroup>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <AnalysisMode>Recommended</AnalysisMode>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <VersionPrefix>7.0.0</VersionPrefix>
        <LangVersion>latest</LangVersion>
        <Authors>A. Shafie</Authors>
        <PackageTags>litebus;mediator;messaging;cqrs</PackageTags>
        <PackageIcon>icon.png</PackageIcon>
        <Description>Mediator and durable messaging contracts for explicit command, query, event, inbox, and outbox composition in .NET applications.</Description>
        <PackageProjectUrl>https://litebus.io/</PackageProjectUrl>
        <!--
            A package is released from a tag, and a pre-release tag may sit on a release branch that has not merged to
            main yet. The release for the version being packed resolves in both cases, and it keeps resolving after the
            release branch is deleted. A local pack that names no version falls back to the changelog.
        -->
        <PackageReleaseNotes Condition="'$(Version)' != ''">https://github.com/litenova/LiteBus/releases/tag/v$(Version)</PackageReleaseNotes>
        <PackageReleaseNotes Condition="'$(Version)' == ''">https://github.com/litenova/LiteBus/blob/main/Changelog.md</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/litenova/LiteBus</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <!--
            Strong naming gives the assemblies a stable identity only; it is not a security boundary, and .NET 10 never
            validates the signature. The key pair is committed, as Microsoft's library guidance recommends, so every
            build (forks and security scanners included) signs with the same identity as the published packages.
        -->
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\LiteBus.snk</AssemblyOriginatorKeyFile>
        <!--
            The public key every LiteBus assembly is signed with. InternalsVisibleTo across signed assemblies has to
            name it, so it lives here rather than being repeated at every grant.
        -->
        <LiteBusPublicKey></LiteBusPublicKey>
        <!-- Source Link -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Abstractions'))">
        <Description>Contracts and value objects for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);abstractions;contracts</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Storage.'))">
        <Description>Storage adapter and registration APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);storage;durable-messaging</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Dispatch'))">
        <Description>Outbound dispatch adapter and registration APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);dispatch;durable-messaging</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Ingress'))">
        <Description>Inbox ingress adapter and registration APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);ingress;durable-messaging</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Transport'))">
        <Description>Transport contracts, runtime behavior, or adapter integration for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);transport;broker</PackageTags>
    </PropertyGroup>
    <PropertyGroup Condition="$([System.String]::Copy('$(MSBuildProjectName)').Contains('.Extensions.'))">
        <Description>Host-framework composition APIs for the $(MSBuildProjectName) package.</Description>
        <PackageTags>$(PackageTags);extensions;composition</PackageTags>
    </PropertyGroup>
    <!-- Core packages match none of the suffix rules above, so each states its own description. -->
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus'">
        <Description>Convenience package that references the LiteBus contract and core implementation packages for command, query, and event mediation.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Commands'">
        <Description>Command mediator, command module builder, and handler pipeline for LiteBus command mediation.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Commands.Recurring'">
        <Description>Recurring commands: a hosted loop that sends a configured command through the command mediator on a fixed interval.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Events'">
        <Description>Event mediator with broadcast handler execution, handler filters, and the event module builder.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Queries'">
        <Description>Query mediator, streaming queries, and the query module builder.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Messaging'">
        <Description>Message registry, mediation pipeline, contract registry, and processor host shared by the LiteBus mediators and durable modules.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Inbox'">
        <Description>Durable inbox: persisted command acceptance, lease-based processing with retries, cleanup, and management APIs.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Outbox'">
        <Description>Transactional outbox: event enqueueing with domain state, lease-based publishing, cleanup, and management APIs.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Runtime'">
        <Description>Module registry, module configuration, and dependency registration that compose LiteBus modules.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Saga'">
        <Description>Saga state for inbox command dispatch: correlated state is loaded before and saved after each dispatched message.</Description>
    </PropertyGroup>
    <PropertyGroup Condition="'$(MSBuildProjectName)' == 'LiteBus.Saga.InboxIntegration'">
        <Description>Connects saga state to the inbox processor through a processor envelope hook.</Description>
    </PropertyGroup>
    <ItemGroup>
        <None Include="..\..\assets\logo\icon.png" Pack="true" PackagePath=""/>
        <None Include="..\..\README.md" Pack="true" PackagePath=""/>
        <InternalsVisibleTo Include="LiteBus.Mediator.UnitTests, PublicKey=$(LiteBusPublicKey)"/>
        <InternalsVisibleTo Include="LiteBus.Transport.UnitTests, PublicKey=$(LiteBusPublicKey)"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)..\stylecop.json" Link="stylecop.json"/>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"/>
        <PackageReference Include="StyleCop.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
