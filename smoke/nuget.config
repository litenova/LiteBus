<?xml version="1.0" encoding="utf-8"?>
<!-- The smoke test restores LiteBus from the packages packed into ../artifacts and everything else from nuget.org. -->
<configuration>
    <packageSources>
        <clear/>
        <add key="litebus-local" value="../artifacts"/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="litebus-local">
            <package pattern="LiteBus"/>
            <package pattern="LiteBus.*"/>
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
